<!DOCTYPE html>

<style>
  * {
    font-family: "Arial";
  }

  #config-settings {
    width: 99%;
    height: 199px;
    font-size: 23px;
  }

  .title-div {
    font-size: 31px;
    display: flex;
    justify-content: center;

  }

  .config-submit {
    margin-top: 9px;
    display: flex;
    justify-content: center;
  }

  #submit-config {
    padding: 9px;
    font-size: 23px;
  }


  .post-cfg {
    display: flex;
    justify-content: center;
    font-size: 30px;
  }

  .spann {
    transition: 0.9s;
    color: green;
  }

  .spann:hover {
    font-size: 50px;
    color: #11c84b;
    cursor: default;
  }
</style>

<body>
  <div class="title-div">
    <h1>{{title}}</h1>
  </div>



  {{#if fileEx}}
  <div class="post-cfg">
    <p>Config file has <span class="spann">been created!</span></p>
  </div>
  {{else}}

  <form id="sub-conf">
    <div class="get-config">
      <textarea id="config-settings">{
    "user":"",
    "pass":"",
    "host_upload_folder":""  
}
</textarea>
    </div>
    <div class="config-submit">
      <input id="submit-config" type="submit" value="Submit Config" required>
    </div>
  </form>




  {{/if}}


  <script>

    if (!{{ fileEx }}) {
      document.getElementById('sub-conf').addEventListener('submit', async (e) => {
        e.preventDefault();
        const config = JSON.parse(document.getElementById("config-settings").value);
        console.log(config);


        if (Object.hasOwn(config, "user") && Object.hasOwn(config, "pass") && Object.hasOwn(config, "host_upload_folder")) {
          let pass = false;
          for (const [key, value] of Object.entries(config)) {
            console.log("key ->", key + " " + "value -> ", value)
            if (!value || value.trim() === "") {
              alert(`${key} must have a value`)
              pass = false;
              break;
            } else {
              pass = true;
            }
          }

          if (pass) {
            const response = await fetch('/plugin/dragfiles/config', {
              method: 'POST',
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(config)
            })


            const msg = await response.json();
            alert(msg.message);

            if (msg.status === "OK") {
              location.reload();
            }

          }

        } else {
          alert("The config file must contain user, pass and host_upload_folder")
        }


      });

    }

  </script>


</body>

</html>